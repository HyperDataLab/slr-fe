# Leave these empty to use the local Vite proxy in development.
VITE_BE_URL=
VITE_API_URL=

# Firebase Web API configuration used to exchange the SLR custom token for an ID token.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_CUSTOM_TOKEN_URL=https://identitytoolkit.googleapis.com/v1/accounts:signInWithCustomToken

# HyperDataLab ResearchPulse OAuth Worker. Register this exact callback URL as a Public client:
# http://localhost:5173/auth/sso/callback (local) or https://<frontend-domain>/auth/sso/callback (production).
VITE_HYPERDATALAB_SSO_BASE_URL=https://rpr-grobid-gateway.hpl-storage.workers.dev
VITE_HYPERDATALAB_SSO_CLIENT_ID=

# Legacy core-governance configuration. The current src tree does not use Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
